module.exports.config = () => ({
  MIN_APP_VERSION: '7.5.7', 
  MIN_APP_BUILD: '757', 
  UPDATE_MESSAGE: 'New version available. Please update to the latest version.',

  API_HOST: 'https://sampleapi.wisaw.com',
  CLOUD_FRONT_DISTRIBUTION: '',

  // deletePhoto removes the photo's S3 objects + CDN cache after the soft delete
  // (see lambda-fns/utilities/photoCleanup.ts). Enabled values: true | 1 | yes | on;
  // anything else, including an unset key, keeps cleanup OFF.
  // NOTE: .env / .env.<env> files are gitignored, so this flag never ships with a code change —
  // turning cleanup on is a deploy-time step done per environment in that environment's own env file.
  PHOTO_DELETE_CLEANUP: 'false',

  S3_BUCKET: 'wisaw-img-test',
  S3_IMAGES: 'img.wisaw.com',

  S3_BUCKET_PRIVATE: 'wisaw-img-private-test',

  DB_RESOURCE_ID: 'db-*********************',

  // DB config
    host: 'localhost',
    port: '5432',
    database: 'wisaw',
    username: 'awsroot', // psql.ts maps this to 'user' for pg driver compatibility
    password: 'awsroot',
  // Connection pool tuning (read by ManagedServerlessClient in psql.ts)
    PG_MAX_CONNECTIONS: '80', // controls serverless-postgres clean() threshold (kills idle conns when total > this × 0.8)
    PG_HEALTH_CHECK_INTERVAL_MS: '30000', // 30s — health check interval for idle connections
    PG_HEALTH_CHECK_TIMEOUT_MS: '5000', // 5s — health check query timeout
    PG_CONNECTION_MAX_LIFETIME_MS: '120000', // 2m — rotate connections after this (shorter = fewer stale connections during spikes)
    PG_CLIENT_DEBUG: 'false', // verbose connection lifecycle logging

    TRACE_LOG_ENABLED: 'false',
})
